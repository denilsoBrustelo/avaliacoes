docs/generated/
docs/api/
docs/javadoc/

# ===== TESTES =====
# Test results
test-results/
coverage/
.nyc_output/
junit.xml

# ===== PACKAGE MANAGERS =====
# NPM
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Yarn
.yarn/
.pnp.*

# PNPM
.pnpm-debug.log*

# ===== MISC =====
# Temporary folders
tmp/
temp/

# Archive files
*.zip
*.tar.gz
*.rar

# System files
.DS_Store
Thumbs.db

# Custom scripts
local-scripts/
dev-tools/
