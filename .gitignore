*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
*.truststore

# JWT Secrets
jwt-secret.txt
secrets/

# ===== PRODUÇÃO =====
# Arquivos de configuração de produção
config/production/
.env.production
.env.prod

# Backups
*.sql.gz
*.dump
backup/

# Cache
.cache/
cache/

# ===== DOCUMENTAÇÃO =====
